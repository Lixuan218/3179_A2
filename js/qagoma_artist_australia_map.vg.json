{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 560,
  "height": 360,

  "projection": {
    "type": "mercator",
    "center": [134, -27],
    "scale": 520
  },

  "layer": [

    {
      "data": {
        "url": "Data/australia_states_fixed.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#eee9df",
        "stroke": "#ffffff",
        "strokeWidth": 1.3
      }
    },


    {
      "data": {
        "url": "Data/qagoma_australian_artist_states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "artist_count": "number",
            "longitude": "number",
            "latitude": "number"
          }
        }
      },

      "mark": {
        "type": "circle",
        "color": "#a45d3f",
        "opacity": 0.78,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },

      "encoding": {

        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "artist_count",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "range": [90, 2300]
          },
          "legend": null
        },

        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "artist_count",
            "type": "quantitative",
            "title": "Artist associations",
            "format": ","
          }
        ]
      }
    },


    {
      "data": {
        "url": "Data/qagoma_australian_artist_states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "artist_count": "number",
            "longitude": "number",
            "latitude": "number"
          }
        }
      },

      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#3b231f",
        "dy": -17
      },

      "encoding": {

        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "state",
          "type": "nominal"
        }
      }
    }

  ],

  "config": {
    "background": null,

    "view": {
      "stroke": null
    },

    "font": "Arial"
  }
}