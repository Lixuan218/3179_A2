{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 300,
  "height": 300,

  "data": {
    "url": "Data/gallery_types.csv"
  },

  "transform": [
    {
      "calculate": "datum.percentage + '%'",
      "as": "percent_label"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#d7b36a",
        "strokeWidth": 4
      },

      "encoding": {
        "y": {
          "field": "gallery_type",
          "type": "nominal",
          "sort": {
            "field": "percentage",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFontSize": 12,
            "labelColor": "#222222",
            "labelLimit": 210,
            "labelPadding": 8,
            "ticks": false,
            "domain": false
          }
        },

        "x": {
          "field": "percentage",
          "type": "quantitative",
          "scale": {
            "domain": [0, 70]
          },
          "axis": {
            "title": "Percentage of galleries (%)",
            "grid": true,
            "gridColor": "#e6e0d7",
            "tickCount": 8,
            "labelFontSize": 11,
            "titleFontSize": 12,
            "domain": false
          }
        },

        "x2": {
          "datum": 0
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 180,
        "color": "#a45d3f",
        "stroke": "#ffffff",
        "strokeWidth": 2
      },

      "encoding": {
        "y": {
          "field": "gallery_type",
          "type": "nominal",
          "sort": {
            "field": "percentage",
            "order": "descending"
          }
        },

        "x": {
          "field": "percentage",
          "type": "quantitative",
          "scale": {
            "domain": [0, 70]
          }
        },

        "tooltip": [
          {
            "field": "gallery_type",
            "type": "nominal",
            "title": "Gallery type"
          },
          {
            "field": "percentage",
            "type": "quantitative",
            "title": "Percentage"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#3b231f"
      },

      "encoding": {
        "y": {
          "field": "gallery_type",
          "type": "nominal",
          "sort": {
            "field": "percentage",
            "order": "descending"
          }
        },

        "x": {
          "field": "percentage",
          "type": "quantitative",
          "scale": {
            "domain": [0, 70]
          }
        },

        "text": {
          "field": "percent_label",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "background": null,

    "view": {
      "stroke": null
    }
  }
}