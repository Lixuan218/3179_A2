{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 760,
  "height": 420,

  "data": {
    "url": "Data/qagoma_period_artwork_forms.csv",
    "format": {
      "type": "csv",
      "parse": {
        "count": "number",
        "percentage": "number"
      }
    }
  },

  "params": [
    {
      "name": "categorySelect",
      "value": "All"
    }
  ],

  "layer": [

    {
      "mark": {
        "type": "line"
      },

      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "title": "Artistic period",
          "sort": [
            "Before 1900",
            "1900-1949",
            "1950-1979",
            "1980-1999",
            "2000-2024"
          ],
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12,
            "labelColor": "#69645d",
            "labelPadding": 10,
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "titleColor": "#4f4a43",
            "titlePadding": 17,
            "ticks": false,
            "domain": false
          }
        },

        "y": {
          "field": "percentage",
          "type": "quantitative",
          "title": "Share of artworks within period (%)",
          "scale": {
            "domain": [0, 35]
          },
          "axis": {
            "labelFontSize": 11,
            "labelColor": "#69645d",
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "titleColor": "#4f4a43",
            "grid": true,
            "gridColor": "#e6ded3",
            "gridOpacity": 0.65,
            "domain": false,
            "ticks": false
          }
        },

        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Painting",
              "Print",
              "Photograph",
              "Drawing",
              "Sculpture",
              "Ceramic",
              "Other"
            ],
            "range": [
              "#3b231f",
              "#a45d3f",
              "#d7b36a",
              "#735047",
              "#c98562",
              "#b9a57c",
              "#80766d"
            ]
          },
          "legend": null
        },

        "detail": {
          "field": "category"
        },

        "opacity": {
          "condition": {
            "test": "categorySelect === 'All' || datum.category === categorySelect",
            "value": 1
          },
          "value": 0.15
        },

        "strokeWidth": {
          "condition": {
            "test": "categorySelect !== 'All' && datum.category === categorySelect",
            "value": 4
          },
          "value": 2
        },

        "tooltip": [
          {
            "field": "period",
            "type": "nominal",
            "title": "Artistic period"
          },
          {
            "field": "category",
            "type": "nominal",
            "title": "Artwork form"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Artworks",
            "format": ","
          },
          {
            "field": "percentage",
            "type": "quantitative",
            "title": "Share",
            "format": ".2f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },

      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": [
            "Before 1900",
            "1900-1949",
            "1950-1979",
            "1980-1999",
            "2000-2024"
          ]
        },

        "y": {
          "field": "percentage",
          "type": "quantitative"
        },

        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Painting",
              "Print",
              "Photograph",
              "Drawing",
              "Sculpture",
              "Ceramic",
              "Other"
            ],
            "range": [
              "#3b231f",
              "#a45d3f",
              "#d7b36a",
              "#735047",
              "#c98562",
              "#b9a57c",
              "#80766d"
            ]
          },
          "legend": null
        },

        "detail": {
          "field": "category"
        },

        "opacity": {
          "condition": {
            "test": "categorySelect === 'All' || datum.category === categorySelect",
            "value": 1
          },
          "value": 0.18
        },

        "size": {
          "condition": {
            "test": "categorySelect !== 'All' && datum.category === categorySelect",
            "value": 90
          },
          "value": 45
        },

        "tooltip": [
          {
            "field": "period",
            "type": "nominal",
            "title": "Artistic period"
          },
          {
            "field": "category",
            "type": "nominal",
            "title": "Artwork form"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Artworks",
            "format": ","
          },
          {
            "field": "percentage",
            "type": "quantitative",
            "title": "Share",
            "format": ".2f"
          }
        ]
      }
    }
  ],

  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}